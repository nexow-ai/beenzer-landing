---
/**
 * How it works: a phone running the app, built in HTML so it stays sharp,
 * light and live. The screens follow the Flutter rebuild (FLUTTER_MIGRATION.md
 * in nexow-ai/beenzer): zinc surfaces, green accent, a floating glass dock
 * with Create in the middle, Phantom for signing.
 *
 * Desktop: the steps scroll, the phone stays. Phone-sized screens: the steps
 * become a row you swipe, under the phone.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import van from '../assets/posts/van.jpg';
import friends from '../assets/posts/friends.jpg';
import selfie from '../assets/posts/selfie.jpg';
import lights from '../assets/posts/lights.jpg';
import crew from '../assets/posts/crew.jpg';
import portrait from '../assets/posts/portrait.jpg';
import duo from '../assets/posts/duo.jpg';

const steps = [
  {
    id: 'map',
    n: '00',
    title: 'The map is home.',
    body: 'Every pin is a photo or a video, left exactly where it was taken. Tap one to see it, and who was there.',
  },
  {
    id: 'snap',
    n: '01',
    title: 'Snap it.',
    body: 'Shoot a photo or a video, record a sound, or pick something from your gallery. Up to 20 MB a post.',
  },
  {
    id: 'pin',
    n: '02',
    title: 'Pin it.',
    body: 'Your post lands where you are standing. Then choose who can find it: everyone, or only people within the radius you set.',
  },
  {
    id: 'share',
    n: '03',
    title: 'Share it.',
    body: 'Follow friends and see their posts on the map or in your feed. Follow each other back and you can chat.',
  },
  {
    id: 'mint',
    n: '04',
    title: 'Mint it.',
    body: 'Any post can become a Solana NFT. Pick how many editions can exist and their price, approve in Phantom, and edition #1 lands in your wallet.',
  },
];

const mapPins = [
  { img: van, x: 22, y: 30, d: 0 },
  { img: friends, x: 64, y: 22, d: 1 },
  { img: selfie, x: 48, y: 46, d: 2, hot: true },
  { img: lights, x: 78, y: 52, d: 3 },
  { img: crew, x: 30, y: 62, d: 4 },
];
---

<section class="tour section" id="how" aria-labelledby="how-title" data-tour>
  <div class="container head">
    <p class="eyebrow" data-reveal>How it works</p>
    <h2 class="h2" id="how-title" data-split>A camera, a map, and a memory of where.</h2>
  </div>

  <div class="container layout">
    <ol class="steps" role="list" data-steps>
      {
        steps.map((step, i) => (
          <li class="step" data-step={step.id} data-index={i} aria-current={i === 0 ? 'step' : undefined}>
            <div class="step-card">
              <p class="step-n mono">
                <span>{step.n}</span>/04
              </p>
              <h3 class="h3">{step.title}</h3>
              <p class="body">{step.body}</p>
              {step.id === 'pin' && (
                <label class="try">
                  <span class="mono">Try it · visible within</span>
                  <input type="range" min="1" max="100" value="24" data-radius-input aria-label="Visibility radius in km" />
                  <output class="mono" data-radius-out>
                    24 km
                  </output>
                </label>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="device-wrap">
      <div class="device" data-device data-screen="map" data-anim aria-hidden="true">
        <div class="phone">
          <div class="island"></div>
          <div class="screen">
            <div class="statusbar mono"><span>13:41</span><span class="sb-icons"><i></i><i></i><i></i></span></div>

            <!-- 00 · map -->
            <div class="scr scr-map" data-scr="map">
              <div class="topbar">
                <div>
                  <b class="wordmark">BEENZER</b>
                  <span class="place">Savigny</span>
                </div>
                <span class="round"><Icon name="search" size={16} /></span>
                <span class="round badge"><Icon name="bell" size={16} /></span>
              </div>
              <svg class="map" viewBox="0 0 300 560" preserveAspectRatio="xMidYMid slice">
                <rect width="300" height="560" fill="#1c1c20"></rect>
                <path d="M-10 420 C 60 395 120 430 180 418 S 290 380 320 392 V 600 H -10 Z" fill="#14243a"></path>
                <path d="M30 120 q40 -30 80 0 t60 40 q-20 40 -70 30 t-70 -70z" fill="#1d3123"></path>
                <path d="M210 250 q30 -20 55 5 t-5 55 q-40 10 -55 -20 t5 -40z" fill="#1d3123"></path>
                <g fill="none" stroke="#34343b" stroke-linecap="round">
                  <path d="M-10 300 C 80 280 160 330 320 280" stroke-width="7"></path>
                  <path d="M150 -10 C 140 120 170 220 140 420" stroke-width="6"></path>
                  <path d="M-10 180 C 90 200 200 160 320 190" stroke-width="4"></path>
                </g>
                <g fill="none" stroke="#28282e" stroke-width="2">
                  <path d="M40 0 L 60 400"></path><path d="M90 0 L 100 410"></path><path d="M210 0 L 230 400"></path>
                  <path d="M260 0 L 270 390"></path><path d="M0 60 L 300 80"></path><path d="M0 240 L 300 230"></path>
                  <path d="M0 360 L 300 350"></path><path d="M0 130 L 300 120"></path>
                </g>
              </svg>
              <span class="me" style="left:56%;top:58%"></span>
              {
                mapPins.map((pin) => (
                  <span class:list={['mpin', { hot: pin.hot }]} style={`left:${pin.x}%;top:${pin.y}%;--d:${pin.d}`}>
                    <Image src={pin.img} alt="" width={72} height={72} loading="lazy" />
                  </span>
                ))
              }
              <div class="peek">
                <Image src={selfie} alt="" width={96} height={96} loading="lazy" class="peek-img" />
                <div>
                  <b>@mara</b>
                  <span class="mono">Lutry · 2 h · 1.4 km</span>
                  <span class="peek-likes">
                    <Icon name="heart" size={12} /> 128 <Icon name="message-circle" size={12} /> 14
                  </span>
                </div>
              </div>
            </div>

            <!-- 01 · camera -->
            <div class="scr scr-snap" data-scr="snap">
              <video
                class="cam-video"
                muted
                loop
                playsinline
                preload="none"
                poster="/media/camera.webp"
                data-src="/media/camera.mp4"></video>
              <div class="cam-top">
                <span class="round dark"><Icon name="x" size={16} /></span>
                <span class="rec mono"><i></i> 00:04</span>
                <span class="round dark"><Icon name="zap" size={16} /></span>
              </div>
              <div class="cam-bottom">
                <div class="modes mono"><span>Audio</span><span>Photo</span><b>Video</b></div>
                <div class="shutter-row">
                  <span class="gallery"><Image src={duo} alt="" width={64} height={64} loading="lazy" /></span>
                  <span class="shutter"><i></i></span>
                  <span class="round dark"><Icon name="flip-horizontal-2" size={18} /></span>
                </div>
              </div>
            </div>

            <!-- 02 · pin -->
            <div class="scr scr-pin" data-scr="pin">
              <div class="bar"><Icon name="arrow-right" size={18} class="back" /><b>New post</b><span></span></div>
              <div class="draft">
                <img src="/media/camera.webp" alt="" width="64" height="112" loading="lazy" decoding="async" />
                <div>
                  <p>Neon hour 💚</p>
                  <span class="chip-s mono"><Icon name="map-pin" size={11} /> Savigny · 46.54° N 6.72° E</span>
                </div>
              </div>
              <div class="radius-map">
                <svg viewBox="0 0 260 150" preserveAspectRatio="xMidYMid slice">
                  <rect width="260" height="150" fill="#1c1c20"></rect>
                  <path d="M-10 118 C 50 100 110 128 170 116 S 250 92 270 98 V 160 H -10 Z" fill="#14243a"></path>
                  <g fill="none" stroke="#34343b" stroke-width="3"><path d="M-10 80 C 80 66 160 96 270 70"></path><path
                      d="M130 -10 C 124 50 140 90 124 160"></path></g>
                  <circle cx="130" cy="78" r="38" class="radius" data-radius-circle></circle>
                  <circle cx="130" cy="78" r="4.5" fill="#16fd82"></circle>
                </svg>
                <span class="radius-label mono" data-radius-label>24 km</span>
              </div>
              <div class="field">
                <span class="label mono">Who can find it</span>
                <div class="seg"><span>Everyone</span><b>Nearby</b></div>
              </div>
              <div class="field">
                <span class="label mono">Within <span data-radius-text>24 km</span></span>
                <span class="slider"><i data-radius-fill style="--v:0.24"></i></span>
              </div>
              <div class="field row">
                <span>Editions</span>
                <span class="stepper mono"><i>−</i><b>20</b><i>+</i></span>
              </div>
              <span class="cta-btn">Drop it here</span>
            </div>

            <!-- 03 · share -->
            <div class="scr scr-share" data-scr="share">
              <div class="bar"><b class="wordmark">BEENZER</b><span class="round"><Icon name="bell" size={15} /></span></div>
              <div class="seg wide"><b>Friends</b><span>Public</span></div>
              <div class="feed">
                <article class="post">
                  <header>
                    <Image src={portrait} alt="" width={48} height={48} loading="lazy" class="av" />
                    <div><b>@jonas</b><span class="mono">Lausanne · 12 min</span></div>
                  </header>
                  <video
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster="/media/feed-party.webp"
                    data-src="/media/feed-party.mp4"></video>
                  <footer>
                    <span><Icon name="heart" size={14} /> 86</span>
                    <span><Icon name="message-circle" size={14} /> 9</span>
                    <span><Icon name="share-2" size={14} /></span>
                    <span class="mono km">2.1 km</span>
                  </footer>
                </article>
                <article class="post">
                  <header>
                    <Image src={friends} alt="" width={48} height={48} loading="lazy" class="av" />
                    <div><b>@lea</b><span class="mono">Vevey · 1 h</span></div>
                  </header>
                  <video
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster="/media/feed-guitar.webp"
                    data-src="/media/feed-guitar.mp4"></video>
                </article>
              </div>
              <div class="toast">
                <Image src={portrait} alt="" width={40} height={40} loading="lazy" class="av" />
                <div><b>Jonas</b><span>Still at the lake? 🌅</span></div>
              </div>
            </div>

            <!-- 04 · mint -->
            <div class="scr scr-mint" data-scr="mint">
              <div class="sheet">
                <span class="grabber"></span>
                <b class="sheet-title">Mint on Solana</b>
                <div class="sheet-rows mono">
                  <div><span>Editions</span><b>20</b></div>
                  <div><span>Price each</span><b>0.1 SOL</b></div>
                  <div><span>Royalties</span><b>10%</b></div>
                </div>
                <span class="phantom"><Icon name="wallet" size={15} /> Approve in Phantom</span>
                <ol class="logs mono" role="list">
                  <li style="--i:0"><i></i>Media saved to Arweave</li>
                  <li style="--i:1"><i></i>Metadata saved to Arweave</li>
                  <li style="--i:2"><i></i>Minted in the Beenzer collection</li>
                  <li style="--i:3"><i></i>Edition #1 sent to your wallet</li>
                </ol>
              </div>
            </div>

            <nav class="dock" data-dock>
              <i class="on"><Icon name="map" size={16} /></i>
              <i><Icon name="users" size={16} /></i>
              <i class="create"><Icon name="plus" size={20} /></i>
              <i><Icon name="message-circle" size={16} /></i>
              <i class="avatar"><Image src={selfie} alt="" width={40} height={40} loading="lazy" /></i>
            </nav>
          </div>
        </div>
        <div class="device-glow"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .tour {
    --phone-w: min(330px, 34vh);
  }
  .head {
    display: grid;
    gap: 20px;
    max-width: calc(var(--max) + var(--gutter) * 2);
  }
  .head .h2 {
    max-width: 16ch;
  }
  .layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    margin-top: clamp(32px, 6vw, 80px);
  }

  /* ---------- steps ---------- */
  .steps {
    display: grid;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .step {
    min-height: 82vh;
    display: flex;
    align-items: center;
  }
  .step:first-child {
    min-height: 62vh;
  }
  /* Room below the last step, so the phone stays put while it is read. */
  .step:last-child {
    min-height: 100vh;
  }
  /* Inactive steps recede in colour, not in opacity, so they stay readable. */
  .step-card {
    display: grid;
    gap: 16px;
    max-width: 30rem;
    color: var(--text-3);
    transition: color 0.6s var(--ease-out);
  }
  .step-card .body,
  .step-card .h3 {
    color: inherit;
    transition: color 0.6s var(--ease-out);
  }
  .step[aria-current] .step-card .h3 {
    color: var(--text);
  }
  .step[aria-current] .step-card .body {
    color: var(--text-2);
  }
  .step-n {
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .step-n span {
    color: var(--neon);
  }
  .step .h3 {
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
  }
  .step .body {
    font-size: 1.1rem;
  }
  .try {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 10px 16px;
    margin-top: 8px;
    padding: 16px 18px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.03);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .try > .mono {
    grid-column: 1 / -1;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .try input {
    width: 100%;
    accent-color: var(--neon);
    height: 28px;
  }
  .try output {
    min-width: 4.5em;
    text-align: right;
    color: var(--neon);
  }

  /* ---------- device ---------- */
  .device-wrap {
    position: relative;
  }
  .device {
    position: sticky;
    top: calc(50vh - var(--phone-w) * 1.05);
    display: grid;
    place-items: center;
    padding-block: 24px;
  }
  .device-glow {
    position: absolute;
    inset: 15% 10%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(22 253 130 / 0.22), transparent);
    filter: blur(40px);
  }
  .phone {
    position: relative;
    width: var(--phone-w);
    aspect-ratio: 9 / 19.5;
    padding: 2.8%;
    border-radius: 15% / 7%;
    background: linear-gradient(145deg, #2a2a30, #0c0c0e 40%, #1d1d22);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.12),
      inset 0 0 0 5px #0a0a0b,
      0 40px 100px -30px rgb(0 0 0 / 0.9),
      0 0 0 1px rgb(0 0 0 / 0.6);
    transform: perspective(1400px) rotateY(-8deg) rotateX(4deg);
    transition: transform 1.2s var(--ease-out);
    /* The screen's type and spacing scale with the phone. */
    container-type: inline-size;
  }
  .device:hover .phone {
    transform: perspective(1400px) rotateY(0) rotateX(0);
  }
  .island {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 3.6%;
    width: 30%;
    height: 3.6%;
    translate: -50% 0;
    border-radius: 99px;
    background: #000;
  }
  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 12.5% / 5.8%;
    background: #18181b;
    font-size: 3.6cqw;
    color: #fff;
    font-family: var(--font-body);
  }
  .screen :global(svg.icon) {
    width: 1.5em;
    height: 1.5em;
  }
  .statusbar {
    position: absolute;
    z-index: 4;
    inset: 0 0 auto;
    display: flex;
    justify-content: space-between;
    padding: 4.2% 9% 0;
    font-size: 0.95em;
    font-weight: 600;
  }
  .sb-icons {
    display: flex;
    gap: 0.35em;
    align-items: center;
  }
  .sb-icons i {
    display: block;
    width: 1.1em;
    height: 0.7em;
    border-radius: 0.2em;
    background: #fff;
    opacity: 0.9;
  }
  .sb-icons i:last-child {
    width: 1.8em;
  }

  .scr {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.04);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.8s var(--ease-out),
      visibility 0s 0.55s;
  }
  [data-screen='map'] .scr-map,
  [data-screen='snap'] .scr-snap,
  [data-screen='pin'] .scr-pin,
  [data-screen='share'] .scr-share,
  [data-screen='mint'] .scr-mint,
  [data-screen='mint'] .scr-pin {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.8s var(--ease-out),
      visibility 0s;
  }

  .round {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    background: rgb(39 39 42 / 0.9);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .round.dark {
    background: rgb(0 0 0 / 0.4);
    backdrop-filter: blur(8px);
  }
  .badge {
    position: relative;
  }
  .badge::after {
    content: '';
    position: absolute;
    top: 0.45em;
    right: 0.5em;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 2px #27272a;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35em;
    letter-spacing: -0.02em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* map */
  .topbar {
    position: absolute;
    z-index: 3;
    inset: 13% 6% auto;
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .topbar > div {
    display: grid;
    margin-right: auto;
    line-height: 1.15;
  }
  .place {
    font-size: 0.85em;
    color: #a1a1aa;
  }
  .map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .me {
    position: absolute;
    width: 1em;
    height: 1em;
    translate: -50% -50%;
    border-radius: 50%;
    background: #3b82f6;
    box-shadow:
      0 0 0 0.25em rgb(255 255 255 / 0.9),
      0 0 0 0.9em rgb(59 130 246 / 0.25);
  }
  .mpin {
    position: absolute;
    width: 3.4em;
    height: 3.4em;
    translate: -50% -100%;
    padding: 0.2em;
    border-radius: 50% 50% 50% 0.3em;
    rotate: -45deg;
    background: #22c55e;
    box-shadow: 0 0.6em 1.4em rgb(0 0 0 / 0.5);
    opacity: 0;
  }
  .mpin :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    rotate: 45deg;
  }
  .mpin.hot {
    width: 4.4em;
    height: 4.4em;
    background: var(--neon);
    box-shadow:
      0 0 2em rgb(22 253 130 / 0.6),
      0 0.6em 1.4em rgb(0 0 0 / 0.5);
  }
  [data-screen='map'] .mpin {
    animation: drop 0.9s var(--ease-out) both;
    animation-delay: calc(0.25s + var(--d) * 0.12s);
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translate(-1.2em, -1.2em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .peek {
    position: absolute;
    z-index: 3;
    inset: auto 5% 17%;
    display: flex;
    gap: 0.8em;
    align-items: center;
    padding: 0.7em;
    border-radius: 1.4em;
    background: rgb(24 24 27 / 0.92);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    transform: translateY(140%);
    transition: transform 0.8s var(--ease-out) 0.9s;
  }
  [data-screen='map'] .peek {
    transform: none;
  }
  .peek :global(.peek-img) {
    width: 3.6em;
    height: 3.6em;
    border-radius: 0.9em;
    object-fit: cover;
  }
  .peek div {
    display: grid;
    gap: 0.15em;
    line-height: 1.2;
  }
  .peek .mono {
    font-size: 0.8em;
    color: #a1a1aa;
  }
  .peek-likes {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.85em;
    color: #a1a1aa;
  }
  .peek-likes :global(svg.icon) {
    width: 1.1em;
    height: 1.1em;
  }

  /* dock */
  .dock {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: 4%;
    translate: -50% 0;
    display: flex;
    gap: 0.45em;
    padding: 0.45em;
    border-radius: 99px;
    background: rgb(39 39 42 / 0.72);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 1.2em 2.4em rgb(0 0 0 / 0.5);
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-out);
  }
  [data-screen='snap'] .dock,
  [data-screen='pin'] .dock,
  [data-screen='mint'] .dock {
    opacity: 0;
    transform: translateY(150%);
  }
  .dock i {
    display: grid;
    place-items: center;
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    color: #d4d4d8;
    font-style: normal;
  }
  .dock i.on {
    background: #22c55e;
    color: #fff;
  }
  [data-screen='share'] .dock i.on {
    background: none;
    color: #d4d4d8;
  }
  [data-screen='share'] .dock i:nth-child(2) {
    background: #22c55e;
    color: #fff;
  }
  .dock i.create {
    width: 3.2em;
    height: 2.6em;
    border-radius: 99px;
    background: linear-gradient(120deg, var(--teal), var(--neon));
