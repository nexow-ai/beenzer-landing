---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import selfie from '../assets/beenzer-18.jpg';
import { FEATURED, formatLat, formatLon } from '../data/site';

const date = new Date(`${FEATURED.date}T${FEATURED.timeUtc}Z`);
const day = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<section class="hero" id="top" aria-label="Beenzer" data-hero>
  <div class="stage" data-stage>
    <canvas class="globe" data-globe aria-hidden="true"></canvas>
    <div class="poster" aria-hidden="true"></div>
    <div class="shade" aria-hidden="true"></div>

    <div class="intro container" data-intro>
      <p class="chip status">
        <span class="live-dot" aria-hidden="true"></span>
        Being rebuilt in Flutter · iOS &amp; Android
      </p>
      <h1 class="display headline">
        <span class="line"><span>Been there.</span></span>
        <span class="line"><span class="grad-text">Done that.</span></span>
      </h1>
      <p class="lead">
        Beenzer pins your photos and videos to the exact place you took them. Follow friends, find them on the map,
        and turn any moment into a Solana NFT, only if you want to.
      </p>
      <div class="actions">
        <a class="btn" href="#how">See how it works <Icon name="arrow-down" /></a>
        <a class="btn ghost" href="#follow">Follow the build</a>
      </div>
    </div>

    <div class="hud mono" aria-hidden="true">
      <span>Lat <b data-hud-lat>—</b></span>
      <span>Lon <b data-hud-lon>—</b></span>
      <span>Alt <b data-hud-alt>—</b> km</span>
    </div>

    <p class="beat h2" data-beat>Every photo was taken <em>somewhere.</em></p>
    <p class="beat h2" data-beat>Most apps forget where. <span class="grad-text">Beenzer keeps it.</span></p>

    <svg class="leader" aria-hidden="true"><line data-leader x1="0" y1="0" x2="0" y2="0"></line><circle
        data-leader-dot
        r="4"></circle></svg>

    <article class="arrival" data-arrival aria-labelledby="arrival-title">
      <p class="arrival-kicker mono">{day} · {FEATURED.timeUtc.slice(0, 5)} UTC</p>
      <h2 class="arrival-title h3" id="arrival-title">Vincent was here.</h2>
      <div class="arrival-body">
        <Image
          src={selfie}
          alt="The photo of BEENZER #18: a selfie of Vincent at home."
          widths={[120, 240]}
          sizes="120px"
          class="arrival-photo"
          loading="lazy"
        />
        <dl class="arrival-meta mono">
          <div><dt>Token</dt><dd>{FEATURED.name}</dd></div>
          <div><dt>Place</dt><dd>{FEATURED.city}, CH</dd></div>
          <div>
            <dt>Coords</dt><dd>{formatLat(FEATURED.latitude, 2)}, {formatLon(FEATURED.longitude, 2)}</dd>
          </div>
          <div><dt>Seen within</dt><dd>{FEATURED.visibility}</dd></div>
          <div><dt>Supply</dt><dd>{FEATURED.supply} · floor {FEATURED.floor}</dd></div>
        </dl>
      </div>
      <a class="arrival-link" href={FEATURED.solscan} target="_blank" rel="noopener">
        Check it on Solscan <Icon name="arrow-up-right" size={16} />
      </a>
    </article>

    <a class="cue mono" href="#how" data-cue>
      <span class="cue-line" aria-hidden="true"></span>
      Scroll to land
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 520vh;
    background: var(--bg);
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .globe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }
  .globe-ready .globe {
    opacity: 1;
  }
  /* Without WebGL: the same globe, as a picture (public/globe/poster.webp, rendered from this page). */
  .poster {
    position: absolute;
    inset: 0;
    background: 72% 50% / cover no-repeat;
    opacity: 0;
    transition: opacity 1s;
  }
  /* Only fetched when it is needed. */
  .no-webgl .poster {
    background-image: url('/globe/poster.webp');
    opacity: 1;
  }
  .shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(5 5 6 / 0.85) 0%, rgb(5 5 6 / 0.35) 38%, transparent 60%),
      linear-gradient(0deg, rgb(5 5 6 / 0.9) 0%, transparent 26%),
      linear-gradient(180deg, rgb(5 5 6 / 0.65) 0%, transparent 18%);
  }

  .intro {
    position: absolute;
    inset: auto 0 0;
    padding-bottom: clamp(56px, 12vh, 132px);
    display: grid;
    gap: 28px;
    justify-items: start;
    will-change: transform, opacity;
  }
  .status {
    animation: rise 1.2s var(--ease-out) 0.2s both;
  }
  .headline {
    display: grid;
    margin-left: -0.04em;
  }
  .line {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .line > span {
    display: inline-block;
    animation: line-in 1.4s var(--ease-out) both;
  }
  .line:nth-child(2) > span {
    animation-delay: 0.12s;
  }
  .lead {
    animation: rise 1.2s var(--ease-out) 0.35s both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    animation: rise 1.2s var(--ease-out) 0.5s both;
  }
  @keyframes line-in {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .hud {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(24px, 4vh, 40px);
    display: flex;
    gap: 22px;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .hud b {
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .beat {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    margin-top: -1em;
    max-width: 12ch;
    opacity: 0;
    visibility: hidden;
    text-shadow: 0 2px 40px rgb(0 0 0 / 0.6);
    will-change: transform, opacity;
  }
  .beat em {
    font-style: normal;
    color: var(--neon);
  }

  .leader {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .leader line {
    stroke: rgb(22 253 130 / 0.6);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .leader circle {
    fill: var(--neon);
  }

  .arrival {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    width: min(400px, calc(100vw - var(--gutter) * 2));
    padding: 22px;
    border-radius: var(--radius);
    background: rgb(12 12 14 / 0.72);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 30px 80px -20px rgb(0 0 0 / 0.8);
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }
  .arrival-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--neon);
  }
  .arrival-title {
    margin: 8px 0 18px;
  }
  .arrival-body {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 18px;
    align-items: start;
  }
  .arrival-body :global(.arrival-photo) {
    width: 96px;
    height: 136px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 0 0 1px var(--line-strong);
  }
  .arrival-meta {
    display: grid;
    gap: 7px;
    font-size: 0.74rem;
  }
  .arrival-meta div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 7px;
    border-bottom: 1px dashed var(--line);
  }
  .arrival-meta dt {
    color: var(--text-3);
  }
  .arrival-meta dd {
    text-align: right;
  }
  .arrival-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    min-height: 32px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--neon);
  }
  .arrival-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cue {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 36px;
    overflow: hidden;
    background: var(--line);
  }
  .cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--neon);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  @media (min-width: 1021px) {
    .intro {
      inset: 0;
      align-content: end;
    }
  }

  @media (max-width: 820px), (max-aspect-ratio: 9/10) {
    .shade {
      background:
        linear-gradient(0deg, rgb(5 5 6 / 0.96) 0%, rgb(5 5 6 / 0.7) 34%, transparent 62%),
        linear-gradient(180deg, rgb(5 5 6 / 0.6) 0%, transparent 16%);
    }
    .poster {
      inset: 0 0 30%;
      background-size: auto 78%;
      background-position: 72% 30%;
    }
    .intro {
      gap: 20px;
      padding-bottom: 92px;
    }
    .hud {
      top: calc(var(--header-h) + 8px);
      bottom: auto;
      left: var(--gutter);
      right: auto;
      gap: 14px;
      font-size: 0.62rem;
    }
    .beat {
      top: auto;
      bottom: 18vh;
      margin-top: 0;
      max-width: 14ch;
      font-size: clamp(1.9rem, 8.6vw, 2.6rem);
    }
    .arrival {
      top: auto;
      bottom: 16px;
      translate: 0 0;
      left: var(--gutter);
      padding: 18px;
    }
    .arrival-title {
      margin: 6px 0 14px;
    }
    .cue {
      display: none;
    }
  }

  /* No dive without motion or WebGL: the hero is one screen, and #18 waits in the showcase below. */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .beat,
    .arrival,
    .leader,
    .cue {
      display: none;
    }
  }
  .hero:has(.no-webgl) {
    height: auto;
  }
  .no-webgl :is(.beat, .arrival, .leader, .cue) {
    display: none;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-hero]');
  const stage = section?.querySelector<HTMLElement>('[data-stage]');

  // Three.js loads after the headline has painted, when the browser is idle.
  const start = () => {
    if (!section || !stage) return;
    import('../scripts/globe').then(({ mountGlobe }) => mountGlobe(stage, section)).catch(() => {
      stage.classList.add('no-webgl');
    });
  };
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
  else setTimeout(start, 200);
</script>
