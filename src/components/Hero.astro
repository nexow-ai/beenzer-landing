---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import selfie from '../assets/beenzer-18.jpg';
import { FEATURED, formatLat, formatLon } from '../data/site';
import { rich, useLocale } from '../i18n';

const { t, fill, date: formatDate } = useLocale(Astro.url);
const day = formatDate(new Date(`${FEATURED.date}T${FEATURED.timeUtc}Z`), { day: 'numeric', month: 'short', year: 'numeric' });
---

<!--
  Before the hero is parsed: is there a real GPU? A software rasteriser
  (SwiftShader, llvmpipe) takes hundreds of milliseconds a frame, so there,
  as without WebGL or JavaScript, the globe is a poster, fetched at once.
  Sets <html data-gpu="hardware|software|none">.
-->
<script is:inline>
  (function () {
    var kind = 'none';
    try {
      var canvas = document.createElement('canvas');
      var gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
      if (gl) {
        var debug = gl.getExtension('WEBGL_debug_renderer_info');
        var name = String(gl.getParameter(debug ? debug.UNMASKED_RENDERER_WEBGL : gl.RENDERER));
        kind = /swiftshader|llvmpipe|softpipe|software|basic render/i.test(name) ? 'software' : 'hardware';
        var lose = gl.getExtension('WEBGL_lose_context');
        if (lose) lose.loseContext();
      }
    } catch (e) {}
    document.documentElement.setAttribute('data-gpu', kind);
  })();
</script>

<section class="hero" id="top" aria-label="Beenzer" data-hero>
  <div class="stage" data-stage data-anim>
    <canvas class="globe" data-globe aria-hidden="true"></canvas>
    <div class="poster" aria-hidden="true"></div>
    <div class="shade" aria-hidden="true"></div>

    <div class="intro container" data-intro>
      <p class="chip status">
        <span class="live-dot" aria-hidden="true"></span>
        {t.hero.status}
      </p>
      <!-- The brand line is the same in every language, and reads left to right in all of them. -->
      <h1 class="display headline" lang="en" translate="no">
        <span class="line"><span dir="ltr">Beenzer.</span></span>
        <span class="line"><span class="grad-text" dir="ltr">Done that.</span></span>
      </h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="actions">
        <a class="btn" href="#how">{t.hero.how} <Icon name="arrow-down" /></a>
        <a class="btn ghost" href="#follow">{t.hero.follow}</a>
      </div>
    </div>

    <div class="hud mono" aria-hidden="true">
      <span>{t.hero.lat} <b dir="ltr" data-hud-lat>—</b></span>
      <span>{t.hero.lon} <b dir="ltr" data-hud-lon>—</b></span>
      <span>{t.hero.alt} <b dir="ltr" data-hud-alt>—</b> km</span>
    </div>

    {t.hero.beats.map((beat) => <p class="beat h2" data-beat set:html={rich(beat)} />)}

    <svg class="leader" aria-hidden="true"><line data-leader x1="0" y1="0" x2="0" y2="0"></line><circle
        data-leader-dot
        r="4"></circle></svg>

    <article class="arrival" data-arrival aria-labelledby="arrival-title">
      <p class="arrival-kicker mono">{day} · {FEATURED.timeUtc.slice(0, 5)} UTC</p>
      <h2 class="arrival-title h3" id="arrival-title">{t.hero.arrival.title}</h2>
      <div class="arrival-body">
        <Image
          src={selfie}
          alt={t.hero.arrival.alt}
          widths={[120, 240]}
          sizes="120px"
          class="arrival-photo"
          loading="lazy"
        />
        <dl class="arrival-meta mono">
          <div><dt>{t.hero.arrival.token}</dt><dd>{FEATURED.name}</dd></div>
          <div><dt>{t.hero.arrival.place}</dt><dd>{FEATURED.city}, CH</dd></div>
          <div>
            <dt>{t.hero.arrival.coords}</dt>
            <dd><bdi>{formatLat(FEATURED.latitude, 2)}, {formatLon(FEATURED.longitude, 2)}</bdi></dd>
          </div>
          <div><dt>{t.hero.arrival.seen}</dt><dd>{FEATURED.visibility}</dd></div>
          <div>
            <dt>{t.hero.arrival.supply}</dt>
            <dd>{FEATURED.supply} · {fill(t.hero.arrival.floor, { price: FEATURED.floor })}</dd>
          </div>
        </dl>
      </div>
      <a class="arrival-link" href={FEATURED.solscan} target="_blank" rel="noopener">
        {t.hero.arrival.solscan} <Icon name="arrow-up-right" size={16} />
      </a>
    </article>

    <a class="cue mono" href="#how" data-cue>
      <span class="cue-line" aria-hidden="true"></span>
      {t.hero.cue}
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 520vh;
    background: var(--bg);
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .globe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }
  .globe-ready .globe {
    opacity: 1;
  }
  /* Without WebGL: the same globe, as a picture (public/globe/poster.webp, rendered from this page). */
  .poster {
    position: absolute;
    inset: 0;
    background: 72% 50% / cover no-repeat;
    opacity: 0;
  }
  /* Only fetched when it is needed. */
  :global(html:not([data-gpu='hardware'])) .poster,
  .no-webgl .poster {
    background-image: url('/globe/poster.webp');
    opacity: 1;
  }
  .shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(5 5 6 / 0.85) 0%, rgb(5 5 6 / 0.35) 38%, transparent 60%),
      linear-gradient(0deg, rgb(5 5 6 / 0.9) 0%, transparent 26%),
      linear-gradient(180deg, rgb(5 5 6 / 0.65) 0%, transparent 18%);
  }
  /* Right-to-left: the copy is on the right, so the shade and the globe swap sides. */
  :global([dir='rtl']) .shade {
    background:
      linear-gradient(270deg, rgb(5 5 6 / 0.85) 0%, rgb(5 5 6 / 0.35) 38%, transparent 60%),
      linear-gradient(0deg, rgb(5 5 6 / 0.9) 0%, transparent 26%),
      linear-gradient(180deg, rgb(5 5 6 / 0.65) 0%, transparent 18%);
  }
  /* The poster cannot be mirrored (the continents would be): slide it left instead.
     Its globe spans the right 62% of a 1.6:1 picture and is cut by its right
     edge, which now lands at 102.4svh: fade out before it. */
  @media (min-width: 821px) and (min-aspect-ratio: 9/10) {
    :global([dir='rtl']) .poster {
      background-size: auto 100%;
      background-position: calc(-0.576 * 100svh) 50%;
      mask-image: linear-gradient(90deg, #000 72svh, transparent 101svh);
    }
  }

  .intro {
    position: absolute;
    inset: auto 0 0;
    padding-bottom: clamp(56px, 12vh, 132px);
    display: grid;
    gap: 28px;
    justify-items: start;
    will-change: transform, opacity;
  }
  .status {
    animation: rise 1.2s var(--ease-out) 0.2s both;
  }
  .headline {
    display: grid;
    margin-left: -0.04em;
    /* Bounded by the height too, for landscape phones and short windows. */
    font-size: clamp(2.4rem, min(7.4vw, 13.5vh), 8.25rem);
  }
  .line {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .line > span {
    display: inline-block;
    animation: line-in 1.4s var(--ease-out) both;
  }
  .line:nth-child(2) > span {
    animation-delay: 0.12s;
  }
  .lead {
    animation: rise 1.2s var(--ease-out) 0.35s both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    animation: rise 1.2s var(--ease-out) 0.5s both;
  }
  @keyframes line-in {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .hud {
    position: absolute;
    inset-inline-end: var(--gutter);
    bottom: clamp(24px, 4vh, 40px);
    display: flex;
    gap: 22px;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .hud b {
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .beat {
    position: absolute;
    inset-inline-start: var(--gutter);
    top: 50%;
    margin-top: -1em;
    max-width: 12ch;
    opacity: 0;
    visibility: hidden;
    text-shadow: 0 2px 40px rgb(0 0 0 / 0.6);
    will-change: transform, opacity;
  }
  .beat :global(em) {
    font-style: normal;
    color: var(--neon);
  }

  .leader {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .leader line {
    stroke: rgb(22 253 130 / 0.6);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .leader circle {
    fill: var(--neon);
  }

  .arrival {
    position: absolute;
    inset-inline-start: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    width: min(400px, calc(100vw - var(--gutter) * 2));
    padding: 22px;
    border-radius: var(--radius);
    background: rgb(12 12 14 / 0.72);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 30px 80px -20px rgb(0 0 0 / 0.8);
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }
  .arrival-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--neon);
  }
  .arrival-title {
    margin: 8px 0 18px;
  }
  .arrival-body {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 18px;
    align-items: start;
  }
  .arrival-body :global(.arrival-photo) {
    width: 96px;
    height: 136px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 0 0 1px var(--line-strong);
  }
  .arrival-meta {
    display: grid;
    gap: 7px;
    font-size: 0.74rem;
  }
  .arrival-meta div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 7px;
    border-bottom: 1px dashed var(--line);
  }
  .arrival-meta dt {
    color: var(--text-3);
  }
  .arrival-meta dd {
    text-align: end;
  }
  .arrival-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    min-height: 32px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--neon);
  }
  .arrival-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cue {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 36px;
    overflow: hidden;
    background: var(--line);
  }
  .cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--neon);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  @media (min-width: 1021px) {
    .intro {
      inset: 0;
      align-content: end;
    }
  }

  @media (max-width: 820px), (max-aspect-ratio: 9/10) {
    .shade {
      background:
        linear-gradient(0deg, rgb(5 5 6 / 0.96) 0%, rgb(5 5 6 / 0.7) 34%, transparent 62%),
        linear-gradient(180deg, rgb(5 5 6 / 0.6) 0%, transparent 16%);
    }
    .poster {
      inset: 0 0 30%;
      background-size: auto 78%;
      background-position: 72% 30%;
    }
    .intro {
      gap: 20px;
      padding-bottom: 92px;
    }
    .hud {
      top: calc(var(--header-h) + 8px);
      bottom: auto;
      inset-inline: var(--gutter) auto;
      gap: 14px;
      font-size: 0.62rem;
    }
    .beat {
      top: auto;
      bottom: 18vh;
      margin-top: 0;
      max-width: 14ch;
      font-size: clamp(1.9rem, 8.6vw, 2.6rem);
    }
    .arrival {
      top: auto;
      bottom: 16px;
      translate: 0 0;
      inset-inline-start: var(--gutter);
      padding: 18px;
    }
    .arrival-title {
      margin: 6px 0 14px;
    }
    .cue {
      display: none;
    }
  }

  /* No dive without motion or WebGL: the hero is one screen, and #18 waits in the showcase below. */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .beat,
    .arrival,
    .leader,
    .cue {
      display: none;
    }
  }
  :global(html:not([data-gpu='hardware'])) .hero,
  .hero.no-webgl {
    height: auto;
  }
  :global(html:not([data-gpu='hardware'])) :is(.beat, .arrival, .leader, .cue, .hud),
  .no-webgl :is(.beat, .arrival, .leader, .cue, .hud) {
    display: none;
  }

  @media (max-height: 560px) and (orientation: landscape) {
    .intro {
      gap: 14px;
      padding-bottom: 28px;
    }
    .status,
    .cue {
      display: none;
    }
    .intro .lead {
      font-size: 0.95rem;
      max-width: 46ch;
    }
    .actions .btn {
      min-height: 44px;
    }
    .arrival {
      top: calc(var(--header-h) + 8px);
      translate: 0 0;
      padding: 16px;
    }
    .arrival-body :global(.arrival-photo) {
      height: 96px;
    }
    .arrival-title {
      margin: 4px 0 10px;
    }
    .arrival-meta {
      gap: 4px;
    }
    .arrival-meta div {
      padding-bottom: 4px;
    }
    .arrival-link {
      margin-top: 8px;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-hero]');
  const stage = section?.querySelector<HTMLElement>('[data-stage]');

  // Only a real GPU gets the globe (see the inline probe above).
  const hardware = document.documentElement.dataset.gpu === 'hardware';

  // Three.js loads after the headline has painted, when the browser is idle.
  const start = () => {
    if (!section || !stage || !hardware) return;
    import('../scripts/globe')
      .then(({ mountGlobe }) => mountGlobe(stage, section))
      .catch(() => {
        stage.classList.add('no-webgl');
        section.classList.add('no-webgl');
      });
  };
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
  else setTimeout(start, 200);
</script>
