---
import Icon from './Icon.astro';
import { fill, useLocale } from '../i18n';
import type { Post } from '../i18n/journal';

interface Props {
  posts: Post[];
  /** Heading level of each card's title, one below the section it sits in. */
  level?: 2 | 3;
}

const { posts, level = 3 } = Astro.props;
const { t, path, date } = useLocale(Astro.url);
const Title = `h${level}` as 'h2' | 'h3';
const fmt = (d: Date) => date(d, { day: 'numeric', month: 'short', year: 'numeric' });
---

<ul class="cards" role="list">
  {
    posts.map(({ slug, entry: post, fallback }, i) => (
      <li data-reveal>
        <a class="card post" href={path(`/journal/${slug}/`)}>
          <span class="art" aria-hidden="true" style={`--h:${i}`}>
            <i />
            <i />
            <i />
          </span>
          <span class="meta mono">
            <span class="kind">{t.journal.kinds[post.data.kind]}</span>
            <span>{fmt(post.data.date)}</span>
            <span>{fill(t.journal.minutes, { n: post.data.read })}</span>
          </span>
          <Title class="h3" lang={fallback ? 'en' : undefined}>
            {post.data.title}
          </Title>
          <p class="body" lang={fallback ? 'en' : undefined}>
            {post.data.description}
          </p>
          <span class="more">
            {t.journal.read} <Icon name="arrow-right" size={16} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .post {
    display: grid;
    align-content: start;
    gap: 16px;
    height: 100%;
    padding: 18px 18px 26px;
    transition:
      box-shadow 0.3s,
      transform 0.5s var(--ease-out);
  }
  .post:hover {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px rgb(22 253 130 / 0.35);
  }
  /* A tiny map for each post: water, a road, a pin. */
  .art {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background:
      radial-gradient(circle at calc(30% + var(--h) * 20%) 40%, rgb(22 253 130 / 0.25), transparent 30%),
      repeating-linear-gradient(
        calc(25deg + var(--h) * 40deg),
        transparent 0 22px,
        rgb(255 255 255 / 0.05) 22px 24px
      ),
      #141418;
  }
  .art i:nth-child(1) {
    position: absolute;
    inset: auto -10% -30% -10%;
    height: 55%;
    border-radius: 50%;
    background: #13233a;
    rotate: calc(-6deg + var(--h) * 5deg);
  }
  .art i:nth-child(2) {
    position: absolute;
    left: -10%;
    right: -10%;
    top: 46%;
    height: 7px;
    background: #2c2c33;
    rotate: calc(-12deg + var(--h) * 9deg);
  }
  .art i:nth-child(3) {
    position: absolute;
    left: calc(30% + var(--h) * 20%);
    top: 40%;
    width: 18px;
    height: 18px;
    translate: -50% -100%;
    rotate: -45deg;
    border-radius: 50% 50% 50% 2px;
    background: var(--neon);
    box-shadow: 0 0 20px var(--neon);
    transition: transform 0.6s var(--ease-out);
  }
  .post:hover .art i:nth-child(3) {
    transform: translate(3px, -3px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .kind {
    color: var(--neon);
  }
  .post .h3 {
    font-size: 1.35rem;
  }
  .post .body {
    font-size: 0.98rem;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-weight: 500;
    color: var(--text);
  }
  .post:hover .more {
    color: var(--neon);
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
