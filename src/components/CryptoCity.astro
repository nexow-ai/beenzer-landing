---
/**
 * The bottom of the home page: a night city in Beenzer's neon. Solana
 * addresses rain down the sky, the wordmark rises behind the skyline, posts
 * hang pinned over the rooftops, and a grid floor runs towards the viewer.
 * The buildings are two layers (public/city/, after Nexow's Solucky landing)
 * that drift apart with the mouse.
 *
 * Decorative and hidden from assistive tech. The loops pause off screen
 * ([data-anim] in global.css); with prefers-reduced-motion everything holds
 * still and the rain is one frame.
 */

// Posts pinned over the city, across the width at different heights, each bobbing on its own beat.
const pins = [
  { x: 8, y: 30, d: 0 },
  { x: 24, y: 12, d: 1.3 },
  { x: 41, y: 24, d: 0.6 },
  { x: 60, y: 8, d: 1.9 },
  { x: 76, y: 26, d: 0.9 },
  { x: 91, y: 16, d: 2.4 },
];
---

<div class="city" aria-hidden="true" dir="ltr" data-city data-anim>
  <canvas class="rain" data-rain></canvas>
  <span class="word" lang="en">BEENZER</span>
  <div class="haze"></div>
  <div class="layer far">
    <img src="/city/far.svg" alt="" width="1600" height="420" loading="lazy" decoding="async" />
  </div>
  <div class="pins">
    {
      pins.map((p) => (
        <span class="pin" style={`--x:${p.x}%;--y:${p.y}%;--d:${p.d}s`}>
          <svg viewBox="24 4 52 83">
            <path
              fill-rule="evenodd"
              d="M50 86.5L26.6 40.4A25.6 25.6 0 1 1 73.4 40.4ZM50 19.4A8.6 8.6 0 1 0 50 36.6A8.6 8.6 0 1 0 50 19.4Z"
            />
          </svg>
        </span>
      ))
    }
  </div>
  <div class="layer near">
    <img src="/city/near.svg" alt="" width="1600" height="300" loading="lazy" decoding="async" />
  </div>
  <div class="horizon"></div>
  <div class="floor"><div><div></div></div></div>
</div>

<style>
  .city {
    --floor: clamp(56px, 7vw, 112px);
    position: relative;
    height: clamp(320px, 40vw, 600px);
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }
  .city > * {
    position: absolute;
  }

  .rain {
    inset: 0 0 auto;
    width: 100%;
    height: 72%;
    opacity: 0.32;
    mask-image: linear-gradient(to bottom, transparent, #000 20%, #000 45%, transparent);
  }

  /* The wordmark stands behind the city, like the sun in a synthwave sky. */
  .word {
    inset: 4% 0 auto;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 23.5vw;
    line-height: 0.74;
    letter-spacing: -0.06em;
    text-align: center;
    background: linear-gradient(180deg, rgb(22 253 130 / 0.42), rgb(22 253 130 / 0.04) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .haze {
    inset: 0 0 var(--floor);
    background:
      radial-gradient(70% 55% at 50% 100%, rgb(22 253 130 / 0.2), transparent 70%),
      radial-gradient(40% 40% at 50% 100%, rgb(19 152 185 / 0.25), transparent 70%);
  }

  /* The scene sets --px and --py (-0.5 to 0.5) from the mouse; each layer moves by its --depth. */
  .layer,
  .pins {
    transform: translate3d(
      calc(var(--px, 0) * var(--depth) * -1),
      calc(var(--py, 0) * var(--depth) * -0.4),
      0
    );
    transition: transform 0.9s var(--ease-out);
  }
  .layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }
  .far {
    --depth: 18px;
    inset-inline: -3%;
    bottom: var(--floor);
    height: 64%;
    opacity: 0.92;
  }
  .near {
    --depth: 40px;
    inset-inline: -4%;
    bottom: calc(var(--floor) - 1px);
    height: 40%;
  }

  .pins {
    --depth: 28px;
    inset: 0 0 var(--floor);
  }
  /* A pin over the rooftops, its line dropping into the street behind the near buildings. */
  .pin {
    --w: clamp(14px, 1.6vw, 24px);
    position: absolute;
    left: var(--x);
    top: var(--y);
    bottom: 0;
    width: var(--w);
    translate: -50% 0;
  }
  .pin svg {
    display: block;
    width: 100%;
    fill: var(--neon);
    filter: drop-shadow(0 0 10px rgb(22 253 130 / 0.8));
    animation: bob 3.2s ease-in-out infinite;
    animation-delay: calc(var(--d) * -1);
  }
  .pin::after {
    content: '';
    position: absolute;
    left: 50%;
    /* From the pin's tip (its picture is 52 × 83) down. */
    top: calc(var(--w) * 1.6);
    bottom: 0;
    width: 1px;
    background: repeating-linear-gradient(to bottom, rgb(22 253 130 / 0.55) 0 3px, transparent 3px 7px);
  }
  @keyframes bob {
    50% {
      transform: translateY(-8px);
    }
  }

  .horizon {
    inset-inline: 0;
    bottom: var(--floor);
    height: 1px;
    background: var(--neon);
    box-shadow: 0 0 18px 3px rgb(22 253 130 / 0.7);
  }

  /* A grid on a plane tilted away from the viewer, its lines running towards
     the screen. Only a transform animates, so it stays on the compositor. */
  .floor {
    inset: auto 0 0;
    height: var(--floor);
    overflow: hidden;
    perspective: 16rem;
    perspective-origin: 50% 0%;
    background: linear-gradient(to bottom, rgb(22 253 130 / 0.12), var(--bg));
    mask-image: linear-gradient(to bottom, transparent, #000 35%);
  }
  .floor > div {
    position: absolute;
    inset: 0 -60% -200%;
    transform-origin: top center;
    transform: rotateX(64deg);
  }
  .floor > div > div {
    position: absolute;
    inset: -56px 0 0;
    background-image:
      linear-gradient(to right, rgb(22 253 130 / 0.6) 2px, transparent 2px),
      linear-gradient(to bottom, rgb(22 253 130 / 0.6) 2px, transparent 2px);
    background-size: 56px 56px;
    background-position: center top;
    animation: floor 1.6s linear infinite;
  }
  @keyframes floor {
    to {
      transform: translateY(56px);
    }
  }
</style>

<script>
  const city = document.querySelector<HTMLElement>('[data-city]');
  const canvas = city?.querySelector<HTMLCanvasElement>('[data-rain]');
  const ctx = canvas?.getContext('2d');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (city && canvas && ctx) {
    // Streams of base58, the alphabet of Solana addresses, falling at 24 frames a second.
    const ALPHABET = '123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
    const CELL = 18;
    const FPS = 24;
    const pick = () => ALPHABET[Math.floor(Math.random() * ALPHABET.length)]!;
    let drops: { y: number; speed: number; color: string }[] = [];
    let rows = 0;
    let head = '#fff';

    function reset() {
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas!.width = Math.round(canvas!.clientWidth * ratio);
      canvas!.height = Math.round(canvas!.clientHeight * ratio);
      ctx!.setTransform(ratio, 0, 0, ratio, 0, 0);
      const css = getComputedStyle(document.documentElement);
      ctx!.font = `500 ${CELL - 5}px ${css.getPropertyValue('--font-mono')}`;
      ctx!.textAlign = 'center';
      const colors = ['--neon', '--neon', '--green', '--teal'].map((v) => css.getPropertyValue(v).trim());
      head = css.getPropertyValue('--text').trim();
      rows = Math.ceil(canvas!.clientHeight / CELL);
      drops = Array.from({ length: Math.ceil(canvas!.clientWidth / CELL) }, () => ({
        y: -Math.random() * rows * 1.5,
        speed: 0.25 + Math.random() * 0.6,
        color: colors[Math.floor(Math.random() * colors.length)]!,
      }));
    }

    function step() {
      // Fade what is drawn towards transparent: each stream leaves a trail.
      ctx!.globalCompositeOperation = 'destination-out';
      ctx!.fillStyle = 'rgb(0 0 0 / 0.12)';
      ctx!.fillRect(0, 0, canvas!.clientWidth, canvas!.clientHeight);
      ctx!.globalCompositeOperation = 'source-over';
      drops.forEach((drop, column) => {
        const before = Math.floor(drop.y);
        drop.y += drop.speed;
        const row = Math.floor(drop.y);
        if (row !== before && row >= 0) {
          const x = column * CELL + CELL / 2;
          ctx!.fillStyle = drop.color;
          ctx!.fillText(pick(), x, row * CELL);
          ctx!.fillStyle = head;
          ctx!.fillText(pick(), x, (row + 1) * CELL);
        }
        if (row > rows && Math.random() > 0.975) {
          drop.y = -Math.random() * rows * 0.5;
          drop.speed = 0.25 + Math.random() * 0.6;
        }
      });
    }

    let visible = false;
    let started = false;
    let frame = 0;
    let last = 0;
    function loop(time: number) {
      frame = requestAnimationFrame(loop);
      if (time - last < 1000 / FPS) return;
      last = time;
      step();
    }
    function sync() {
      cancelAnimationFrame(frame);
      if (visible && !document.hidden && !reduced) frame = requestAnimationFrame(loop);
    }

    // Nothing runs until the city comes near the screen.
    new IntersectionObserver(
      ([entry]) => {
        visible = entry!.isIntersecting;
        if (visible && !started) {
          started = true;
          reset();
          new ResizeObserver(reset).observe(canvas);
          if (reduced) for (let i = 0; i < 120; i++) step();
        }
        sync();
      },
      { rootMargin: '200px 0px' },
    ).observe(city);
    document.addEventListener('visibilitychange', sync);

    // Depth: the layers drift with a mouse, while the city is in view.
    if (!reduced) {
      let raf = 0;
      window.addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse' || !visible) return;
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            city.style.setProperty('--px', (e.clientX / window.innerWidth - 0.5).toFixed(3));
            city.style.setProperty('--py', (e.clientY / window.innerHeight - 0.5).toFixed(3));
          });
        },
        { passive: true },
      );
    }
  }
</script>
