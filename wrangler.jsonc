// Cloudflare Worker serving the static Astro build (Workers static assets),
// the same way nexow.studio is served. Deploy with `npm run deploy` once the
// domain is attached in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beenzer-landing",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": false,
}
