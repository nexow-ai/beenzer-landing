// Cloudflare Worker serving the static Astro build (Workers static assets),
// the same way nexow.studio is served. Custom domain beenzer.xyz, a zone in
// Nexow's Cloudflare account (attached 2026-10-21); also on *.workers.dev.
// Deploy with `npm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beenzer-landing",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "beenzer.xyz", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
}
