---
/**
 * A visitor whose browser prefers another of the site's languages is offered
 * this page in it, in that language, once. Nothing redirects: the choice, or
 * "no thanks", is kept in this browser (localStorage, no cookie) and the
 * offer does not come back.
 */
import { LOCALES, localizePath, unlocalizePath, useLocale } from '../i18n';

const { locale } = useLocale(Astro.url);
const page = unlocalizePath(Astro.url.pathname);
const here = page.startsWith('/404') ? '/' : page;
const offers = Object.fromEntries(
  LOCALES.filter((l) => l.code !== locale).map((l) => {
    const { t, lang, dir } = useLocale(l.code);
    return [l.code, { lang, dir, href: localizePath(here, l.code), ...t.suggest }];
  }),
);
// Safe inside <script>: no "</" can close it early.
const json = JSON.stringify(offers).replace(/</g, '\\u003c');
---

<aside class="suggest" data-suggest data-locale={locale} hidden>
  <p data-suggest-text></p>
  <div class="actions">
    <!-- A real address for crawlers; the script points it at the offered language. -->
    <a class="btn" href={Astro.url.pathname} data-suggest-go></a>
    <button class="btn ghost" type="button" data-suggest-close></button>
  </div>
  <script is:inline type="application/json" data-suggest-offers set:html={json} />
</aside>

<style>
  .suggest {
    position: fixed;
    inset-inline-start: 16px;
    bottom: 16px;
    z-index: 60;
    display: grid;
    gap: 14px;
    width: min(340px, calc(100vw - 32px));
    padding: 18px;
    border-radius: var(--radius);
    background: rgb(12 12 14 / 0.92);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 30px 80px -20px rgb(0 0 0 / 0.8);
    animation: suggest-in 0.8s var(--ease-out) both;
  }
  .suggest[hidden] {
    display: none;
  }
  p {
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .actions .btn {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9rem;
  }
  @keyframes suggest-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>

<script>
  import { LOCALES } from '../i18n/locales';

  interface Offer {
    lang: string;
    dir: string;
    href: string;
    text: string;
    go: string;
    close: string;
  }

  const KEY = 'beenzer:lang';
  const box = document.querySelector<HTMLElement>('[data-suggest]');
  const codes = new Set<string>(LOCALES.map((l) => l.code));

  /** A browser language tag ("pt-BR", "zh-Hant-HK", "iw") to one of the site's languages. */
  function match(tag: string): string | undefined {
    const t = tag.toLowerCase();
    if (t.startsWith('zh')) return /^zh-(tw|hk|mo|hant)/.test(t) ? 'zh-tw' : 'zh-cn';
    const primary = ({ iw: 'he', in: 'id' } as Record<string, string>)[t.split('-')[0]] ?? t.split('-')[0];
    return codes.has(primary) ? primary : undefined;
  }

  function read() {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }
  function remember(code: string) {
    try {
      localStorage.setItem(KEY, code);
    } catch {}
  }

  if (box) {
    const current = box.dataset.locale!;
    const chosen = read();
    const wanted =
      chosen && codes.has(chosen)
        ? chosen
        : (navigator.languages ?? [navigator.language]).map(match).find((code) => code !== undefined);
    const offers = JSON.parse(box.querySelector('[data-suggest-offers]')?.textContent ?? '{}') as Record<string, Offer>;
    const offer = wanted && wanted !== current ? offers[wanted] : undefined;

    if (offer) {
      box.lang = offer.lang;
      box.dir = offer.dir;
      box.querySelector('[data-suggest-text]')!.textContent = offer.text;
      const go = box.querySelector<HTMLAnchorElement>('[data-suggest-go]')!;
      go.textContent = offer.go;
      go.href = offer.href;
      go.hreflang = offer.lang;
      go.addEventListener('click', () => remember(wanted!));
      const close = box.querySelector<HTMLButtonElement>('[data-suggest-close]')!;
      close.textContent = offer.close;
      close.addEventListener('click', () => {
        remember(current);
        box.hidden = true;
      });
      setTimeout(() => (box.hidden = false), 1200);
    }
  }
</script>
