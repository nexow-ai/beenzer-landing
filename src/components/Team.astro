---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { team } from '../data/team';
import { SITE } from '../data/site';

const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const countries = new Set(team.map((m) => m.country)).size;
---

<section class="team section" id="team" aria-labelledby="team-title">
  <div class="container">
    <div class="head">
      <p class="eyebrow" data-reveal>The crew</p>
      <h2 class="h2" id="team-title" data-split>Engineers, traders, artists. Believers.</h2>
      <p class="lead" data-reveal>
        The first Beenzer was built by an international crew: software, data, finance and art, from{' '}
        {words[countries] ?? countries} countries. Today it is built at{' '}
        <a class="link" href={SITE.owner.url} target="_blank" rel="noopener">{SITE.owner.name}</a>, founded by two of
        them.
      </p>
    </div>

    <ul class="grid" role="list">
      {
        team.map((m) => (
          <li class:list={['member', { founder: m.nexow }]} data-reveal>
            <a href={m.href} target="_blank" rel="noopener" aria-label={`${m.name}, profile`}>
              <span class="photo">
                <Image src={m.photo} alt="" widths={[160, 320]} sizes="160px" loading="lazy" />
              </span>
              <span class="who">
                <span class="name">
                  {m.name}
                  <Icon name="arrow-up-right" size={14} />
                </span>
                <span class="role">
                  {m.role} · {m.also}
                </span>
                <span class="before mono">
                  <span class="cc">{m.country}</span> {m.before}
                </span>
                {m.nexow && <span class="tag mono">{m.nexow}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team {
    border-top: 1px solid var(--line);
  }
  .head {
    display: grid;
    gap: 22px;
    max-width: 52rem;
  }
  .head .h2 {
    max-width: 14ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 12px;
    margin-top: clamp(48px, 7vw, 80px);
  }
  .member a {
    display: flex;
    gap: 16px;
    align-items: center;
    height: 100%;
    padding: 14px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.02);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color 0.3s,
      box-shadow 0.3s,
      transform 0.5s var(--ease-out);
  }
  .member a:hover {
    background: rgb(22 253 130 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(22 253 130 / 0.3);
    transform: translateY(-3px);
  }
  .founder a {
    box-shadow: inset 0 0 0 1px rgb(22 253 130 / 0.22);
  }
  .photo {
    flex: none;
    width: 76px;
    height: 76px;
    overflow: hidden;
    border-radius: 18px;
    background: var(--surface-2);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition:
      filter 0.5s,
      transform 0.8s var(--ease-out);
  }
  .member a:hover .photo :global(img),
  .member a:focus-visible .photo :global(img) {
    filter: none;
    transform: scale(1.06);
  }
  .who {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .name :global(.icon) {
    color: var(--text-3);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .member a:hover .name :global(.icon) {
    opacity: 1;
  }
  .role {
    font-size: 0.88rem;
    color: var(--text-2);
  }
  .before {
    font-size: 0.72rem;
    color: var(--text-3);
  }
  .cc {
    display: inline-block;
    padding: 0 5px;
    margin-inline-end: 4px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--text-2);
  }
  .tag {
    justify-self: start;
    margin-top: 6px;
    padding: 3px 8px;
    border-radius: 99px;
    background: rgb(22 253 130 / 0.1);
    color: var(--neon);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
  }
</style>
