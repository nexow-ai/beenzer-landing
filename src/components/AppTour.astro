  /* ---------- small screens: phone on top, steps in a swipeable row ---------- */
  @media (max-width: 900px) {
    .tour {
      --phone-w: min(250px, 58vw, 29svh);
    }
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .device-wrap {
