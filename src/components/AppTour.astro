      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone {
      transform: none;
    }
  }
</style>

<script>
  const tour = document.querySelector<HTMLElement>('[data-tour]');
  const device = tour?.querySelector<HTMLElement>('[data-device]');
  const stepsList = tour?.querySelector<HTMLElement>('[data-steps]');

  if (tour && device && stepsList) {
    const steps = [...stepsList.querySelectorAll<HTMLElement>('[data-step]')];
    const videos = [...device.querySelectorAll<HTMLVideoElement>('video[data-src]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let inView = false;

    function syncVideos() {
      const screen = device!.dataset.screen;
      for (const video of videos) {
        const scr = video.closest<HTMLElement>('[data-scr]')?.dataset.scr;
        const live = inView && !reduced && scr === screen;
        if (live) {
          if (!video.src) video.src = video.dataset.src!;
          video.play().catch(() => {});
        } else if (!video.paused) video.pause();
      }
    }

    function activate(step: HTMLElement) {
      steps.forEach((s) => (s === step ? s.setAttribute('aria-current', 'step') : s.removeAttribute('aria-current')));
      device!.dataset.screen = step.dataset.step;
      syncVideos();
    }

    // Desktop: the step crossing the middle of the viewport. Phones: the card snapped into the row.
    const narrow = window.matchMedia('(max-width: 900px)');
    let observer: IntersectionObserver | null = null;
    function observe() {
      observer?.disconnect();
      observer = new IntersectionObserver(
        (entries) => {
          const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (hit) activate(hit.target as HTMLElement);
        },
        narrow.matches
          ? { root: stepsList, threshold: [0.6, 0.9] }
          : { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
      );
      steps.forEach((s) => observer!.observe(s));
    }
    observe();
    narrow.addEventListener('change', observe);

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncVideos();
    }).observe(device);

    // The radius: the slider by the step drives the circle on the phone.
    const input = tour.querySelector<HTMLInputElement>('[data-radius-input]');
    const out = tour.querySelector<HTMLOutputElement>('[data-radius-out]');
    const circle = device.querySelector<SVGCircleElement>('[data-radius-circle]');
    const label = device.querySelector<HTMLElement>('[data-radius-label]');
    const text = device.querySelector<HTMLElement>('[data-radius-text]');
    const fill = device.querySelector<HTMLElement>('[data-radius-fill]');
    function setRadius(km: number) {
      const value = `${km} km`;
      if (out) out.value = value;
      if (label) label.textContent = value;
      if (text) text.textContent = value;
      // Square root, so small radii stay visible on the little map.
      circle?.setAttribute('r', String(8 + Math.sqrt(km / 100) * 70));
      fill?.style.setProperty('--v', String(km / 100));
    }
    input?.addEventListener('input', () => {
      setRadius(Number(input.value));
      const pin = steps.find((s) => s.dataset.step === 'pin');
      if (pin && device.dataset.screen !== 'pin') activate(pin);
    });
  }
</script>
