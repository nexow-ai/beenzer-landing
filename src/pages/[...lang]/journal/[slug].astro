---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import JournalCards from '../../components/JournalCards.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const others = (await getCollection('journal')).filter((p) => p.id !== post.id);
const date = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = post.data.date.toISOString();

const article = {
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: iso,
  author: { '@type': 'Organization', name: SITE.owner.name, url: SITE.owner.url },
  publisher: { '@id': `${SITE.owner.url}/#org` },
  mainEntityOfPage: new URL(`/journal/${post.id}/`, Astro.site).href,
};
---

<Base title={post.data.title} description={post.data.description} type="article" published={iso} schema={[article]}>
  <article class="article">
    <header class="container head">
      <a class="back mono" href="/journal/"><Icon name="arrow-right" size={14} class="flip" /> Journal</a>
      <p class="meta mono">
        <span class="kind">{post.data.kind}</span>
        <time datetime={iso}>{date}</time>
        <span>{post.data.read} min read</span>
      </p>
      <h1 class="title" data-split>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
    </header>
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <section class="more container" aria-labelledby="more-title">
    <h2 class="h3" id="more-title">Keep reading</h2>
    <JournalCards posts={others} />
  </section>
</Base>

<style>
  .article {
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 110px));
  }
  /* Header and body share one column, so their left edges line up. */
  .head {
    display: grid;
    gap: 22px;
    max-width: calc(46rem + var(--gutter) * 2);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    min-height: 36px;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    transition: color 0.2s;
  }
  .back:hover {
    color: var(--neon);
  }
  .back :global(.flip) {
    rotate: 180deg;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .kind {
    color: var(--neon);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    font-size: clamp(2.3rem, 5.4vw, 4.6rem);
    text-wrap: balance;
  }
  .head .lead {
    max-width: 46ch;
  }
  .prose {
    max-width: 46rem;
    margin: clamp(48px, 7vw, 88px) auto 0;
    padding-bottom: clamp(72px, 10vw, 120px);
    color: var(--text-2);
    font-size: 1.125rem;
    line-height: 1.75;
  }
  .prose :global(> * + *) {
    margin-top: 1.2em;
  }
  .prose :global(h2) {
    margin-top: 2.2em;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--text);
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--neon);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose :global(ul) {
    padding-inline-start: 1.2em;
  }
  .prose :global(li + li) {
    margin-top: 0.6em;
  }
  .prose :global(li::marker) {
    color: var(--neon);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text);
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.06);
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: 20px 22px;
    border-radius: 16px;
    background: #0b0b0d !important;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding-block: 10px;
    padding-inline: 0 14px;
    border-bottom: 1px solid var(--line);
    text-align: start;
    vertical-align: top;
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .more {
    display: grid;
    gap: 32px;
    padding-top: clamp(64px, 8vw, 96px);
    padding-bottom: clamp(96px, 12vw, 160px);
    border-top: 1px solid var(--line);
  }
</style>
